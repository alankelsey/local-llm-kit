#!/usr/bin/env bash
# llm — local coding model on this machine (Ollama), shared by every project using local-llm-kit.
#   llm up               spread Ollama over all GPUs (sudo once), preload the configured model
#   llm status           configured model, loaded models, VRAM, Ollama mode
#   llm down             unload the model (GPUs idle; Ollama stays in spread mode)
#   llm restore          back to per-card mode via $GPU_SERVICES/install.sh
#   llm model M [ctx]    set the default model (and context) and preload it
#   llm fallback M|off   set the fallback model ("off" disables it)

set -euo pipefail

KIT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
SPREAD_CONF="$KIT/machine/ollama-spread.conf"
SETTINGS=${LOCAL_LLM_SETTINGS:-${XDG_CONFIG_HOME:-$HOME/.config}/local-llm/settings.json}
MODEL=${LOCAL_MODEL:-qwen3.8:27b}
NUM_CTX=${LOCAL_NUM_CTX:-262144}
FALLBACK=${LOCAL_FALLBACK_MODEL:-qwen3.5:122b-a10b}
OLLAMA=${OLLAMA_URL:-http://localhost:11434}
GPU_SERVICES=${GPU_SERVICES:-$HOME/projects/gpu-services}
DROPDIR=/etc/systemd/system/ollama.service.d

load_settings() {
  [[ -f "$SETTINGS" ]] || return 0
  MODEL=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("model", sys.argv[2]))' "$SETTINGS" "$MODEL")
  NUM_CTX=$(python3 -c 'import json,sys; print(int(json.load(open(sys.argv[1])).get("num_ctx", sys.argv[2])))' "$SETTINGS" "$NUM_CTX")
  FALLBACK=$(python3 -c 'import json,sys; v=json.load(open(sys.argv[1])).get("fallback_model", sys.argv[2]); print(v if v else "")' "$SETTINGS" "$FALLBACK")
}
load_settings

save_settings() {
  mkdir -p "$(dirname "$SETTINGS")"
  python3 -c 'import json,sys; d={"model":sys.argv[1],"num_ctx":int(sys.argv[2]),"fallback_model":sys.argv[3]}; open(sys.argv[4],"w").write(json.dumps(d,indent=2)+"\n")' "$MODEL" "$NUM_CTX" "$FALLBACK" "$SETTINGS"
}

vram() {
  for d in /sys/class/drm/card[0-9]*/device; do
    [[ -r "$d/mem_info_vram_total" ]] || continue
    awk -v n="${d%/device}" -v u="$(cat "$d/mem_info_vram_used")" '$1 > 8e9 {printf "%s: %.1f / %.1f GB\n", n, u/1e9, $1/1e9}' "$d/mem_info_vram_total"
  done
}

spread_mode() {
  if [[ ! -f "$DROPDIR/card0.conf" ]] && cmp -s "$SPREAD_CONF" "$DROPDIR/spread.conf"; then
    echo "ollama already in spread mode"; return
  fi
  echo "switching ollama to spread mode (sudo)..."
  systemctl --user stop ollama-card1 comfyui 2>/dev/null || true
  sudo install -D -m 644 "$SPREAD_CONF" "$DROPDIR/spread.conf"
  sudo rm -f "$DROPDIR/card0.conf"
  sudo systemctl daemon-reload && sudo systemctl restart ollama
  for _ in $(seq 30); do curl -sf "$OLLAMA/api/version" >/dev/null && break; sleep 1; done
}

preload() {
  echo "loading $MODEL (first load takes ~30-60s)..."
  curl -sf "$OLLAMA/api/generate" -d "{\"model\":\"$MODEL\",\"prompt\":\"\",\"keep_alive\":\"60m\",\"options\":{\"num_ctx\":$NUM_CTX}}" >/dev/null
  ollama ps
  vram
}

case ${1:-status} in
  up)
    spread_mode; preload ;;
  down)
    ollama stop "$MODEL" 2>/dev/null || true
    [[ -n "$FALLBACK" ]] && { ollama stop "$FALLBACK" 2>/dev/null || true; }
    echo "models unloaded"; vram ;;
  restore)
    sudo rm -f "$DROPDIR/spread.conf"
    "$GPU_SERVICES/install.sh" ;;
  status)
    if [[ -f "$DROPDIR/card0.conf" ]]; then
      echo "ollama: per-card mode (card 0 only)"
    else
      echo "ollama: spread mode"
    fi
    ollama ps; vram
    echo "configured: $MODEL ctx=$NUM_CTX fallback=${FALLBACK:-off} (settings: $SETTINGS)" ;;
  model)
    [[ -n "${2:-}" ]] || { echo "usage: llm model <name> [ctx]"; exit 1; }
    ollama stop "$MODEL" 2>/dev/null || true
    MODEL=$2; NUM_CTX=${3:-$NUM_CTX}
    save_settings
    preload ;;
  fallback)
    [[ -n "${2:-}" ]] || { echo "usage: llm fallback <model|off>"; exit 1; }
    if [[ "$2" == "off" ]]; then
      FALLBACK=""
    else
      FALLBACK=$2
    fi
    save_settings
    echo "fallback set to: ${FALLBACK:-off}" ;;
  *)
    sed -n '2,9p' "$0"; exit 1 ;;
esac
